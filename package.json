{
  "name": "praxis-policy-studio",
  "version": "0.1.0-beta.12",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4302 --proxy-config proxy.conf.json",
    "build": "ng build",
    "check:projections": "node tools/check-projections.mjs",
    "check:local-runtime": "node tools/check-local-runtime.mjs",
    "generate:ergonx-projection": "node tools/generate-ergonx-projection.mjs",
    "sync:quickstart-projection": "node tools/sync-quickstart-projection.mjs",
    "lint": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest run --environment jsdom --exclude e2e/**",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/animations": "21.2.20",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.20",
    "@angular/compiler": "21.2.20",
    "@angular/core": "21.2.20",
    "@angular/forms": "21.2.20",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.20",
    "@angular/router": "21.2.20",
    "@praxisui/ai": "9.0.5-rc.26",
    "@praxisui/core": "9.0.5-rc.26",
    "@praxisui/metadata-editor": "9.0.5-rc.26",
    "@praxisui/settings-panel": "9.0.5-rc.26",
    "@praxisui/visual-builder": "9.0.5-rc.26",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.20",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.9",
    "jasmine-core": "~5.10.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0 <25"
  }
}
